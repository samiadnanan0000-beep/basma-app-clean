rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminUser() {
      return isSignedIn() && (
        request.auth.token.email == 'samialbakri99@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'super_admin', 'admin', 'SUPER_ADMIN']
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isSuperAdminUser() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'DESIGNER', 'super_admin', 'designer', 'admin', 'SUPER_ADMIN']
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSuperAdminUser();
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isStaff();
    }

    match /materials/{materialId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaff();
    }

    match /complaints/{complaintId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isStaff();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
